{
  "name": "omni-desktop",
  "version": "1.6.6",
  "private": true,
  "description": "Omni desktop manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --demo",
    "test": "node --test tests/managers.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.omni.accounts",
    "productName": "Omni",
    "files": [
      "main.js",
      "chatgpt_auto_login.js",
      "credential_store.js",
      "auth_preload.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "target": "dir",
      "icon": "../assets/omni.icns",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "../dist/Omni-Backend",
          "to": "Omni-Backend"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../app.ico",
      "extraResources": [
        {
          "from": "../dist/Omni-Backend.exe",
          "to": "Omni-Backend.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
